---
import { translatePath, type Locale } from '#lib/i18n/index.ts'
import Search from '#features/docs/components/search.astro'
import { getDocsSummary } from '#features/docs/utils/docs-post.ts'
import LanguagePicker from '#components/language-picker.astro'

const locale = Astro.currentLocale as Locale

const [[, [{ url: docsUrl }]]] = await getDocsSummary(locale)

const navItems = [
	{
		url: docsUrl,
		label: 'Docs',
	},
	{
		url: '#',
		label: 'Play.odyc',
		external: true,
	},
	{
		url: 'https://baxel.achtaitaipai.com',
		label: 'Baxel',
		external: true,
	},
]
---

<header
	class="sticky top-0 z-10 grid h-[var(--header-height)] grid-cols-[1fr_auto_1fr] items-center border-b border-gray-200 bg-white px-8"
>
	<div class="flex items-center gap-8">
		<a
			href={translatePath(locale, '/')}
			class="flex items-center gap-1 text-lg font-bold"
		>
			<img src="/logo.png" alt="logo" class="pixelated size-6" />
			Odyc.js</a
		>
		<nav class="flex gap-4">
			{
				navItems.map((el) => (
					<a
						href={el.url}
						target={el.external ? '_blank' : null}
						class="hover:text-accent text-gray-800 transition-colors"
					>
						{el.label}
					</a>
				))
			}
		</nav>
	</div>
	<div><Search className="" /></div>
	<div class="flex items-center justify-end gap-4">
		<!-- <span class="block h-6 w-[1px] bg-gray-200"></span> -->
		<div>
			<LanguagePicker />
		</div>
	</div>
</header>

<style is:global>
	:root {
		--header-height: 4rem;
		--page-height: calc(100vh - var(--header-height));
	}
</style>
