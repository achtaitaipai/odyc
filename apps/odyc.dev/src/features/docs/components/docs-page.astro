---
import DocSummary from '#features/docs/components/docs-summary.astro'
import type { Locale } from '#lib/i18n/index.ts'
import { getDocsPostSlug } from '#features/docs/utils/docs-post.ts'
import type { CollectionEntry } from 'astro:content'
export type Props = {
	post: CollectionEntry<'docs'>
	locale: Locale
}
const { post, locale } = Astro.props
const { Content } = await post.render()
const currentSlug = getDocsPostSlug(post, locale)
---

<div class="flex flex-col md:flex-row">
	<DocSummary {locale} {currentSlug} />
	<main class="px-8 py-10">
		<div class="prose" data-pagefind-body>
			<h1>{post.data.title}</h1>
			<hr class="mt-16 mb-10" />
			<Content />
		</div>
	</main>
</div>
