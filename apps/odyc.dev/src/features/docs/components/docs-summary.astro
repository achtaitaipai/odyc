---
import { getDocsSummary } from '#features/docs/utils/docs-post.ts'
import { useTranslations, type Locale } from '#lib/i18n/index.ts'

export type Props = { locale: Locale; currentSlug: string }

const { locale, currentSlug } = Astro.props
const t = useTranslations(locale)
const summary = await getDocsSummary(locale)
---

<c-docs-summary data-slug={currentSlug}>
	<div class="z-10 border-b border-gray-200 bg-white px-8 py-1 md:hidden">
		<button
			data-menu-btn
			class="cursor-pointer border border-transparent bg-transparent px-2 py-1 transition-colors hover:border-gray-100 hover:bg-gray-50"
			aria-controls="docs-summary-list"
			aria-expanded="false"
			aria-label={t('docs.menu.open.aria')}
		>
			{t('docs.summary')}</button
		>
	</div>
	<div
		data-backdrop
		class="absolute inset-0 hidden bg-white/10 backdrop-blur-xs md:hidden"
		aria-hidden="true"
	>
	</div>
	<aside
		data-aside
		class="fixed top-0 z-10 h-screen w-2xs -translate-x-full overflow-hidden border-r border-gray-200 bg-white transition-transform duration-300 md:sticky md:translate-x-0 md:transition-none"
		role="navigation"
		aria-label={t('docs.navigation.aria')}
	>
		<ul
			id="docs-summary-list"
			class="h-full space-y-4 overflow-auto px-8 py-10"
			transition:persist
		>
			{
				summary.map(([category, items], i) => (
					<>
						<li>
							<span class="font-bold">{category}</span>
							<ul class="mt-2 space-y-2">
								{items.map((el) => (
									<li>
										<a
											href={el.url}
											aria-current={el.slug === currentSlug ? 'page' : false}
											class="group hover:text-accent aria-[current=page]:text-accent relative text-neutral-700"
											data-slug={el.slug}
										>
											<span class="absolute opacity-0 transition-opacity group-aria-[current=page]:opacity-100">
												&loz;
											</span>
											<span class="block transition-transform group-aria-[current=page]:translate-x-3.5">
												{el.title}
											</span>
										</a>
									</li>
								))}
							</ul>
						</li>
						{i < summary.length - 1 && <hr class="mt-8 mb-4 border-gray-200" />}
					</>
				))
			}
		</ul>
	</aside>
</c-docs-summary>

<script>
	customElements.define(
		'c-docs-summary',
		class DocsSummary extends HTMLElement {
			#menuButton: HTMLButtonElement | null = null
			#menuBackdrop: HTMLDivElement | null = null
			#menuAside: HTMLElement | null = null
			#isOpen = false

			constructor() {
				super()
			}

			connectedCallback() {
				this.#menuButton = this.querySelector('[data-menu-btn]')
				this.#menuBackdrop = this.querySelector('[data-backdrop]')
				this.#menuAside = this.querySelector('[data-aside]')

				this.#menuButton?.addEventListener('click', this.#openMenu)
				this.#menuBackdrop?.addEventListener('click', this.#closeMenu)
				document.addEventListener('keydown', this.#handleKeyDown)
				document.addEventListener('astro:page-load', this.#updateCurrentPage)
			}

			disconnectedCallback() {
				this.#menuButton?.removeEventListener('click', this.#openMenu)
				this.#menuBackdrop?.removeEventListener('click', this.#closeMenu)
				document.removeEventListener('keydown', this.#handleKeyDown)
				document.removeEventListener('astro:page-load', this.#updateCurrentPage)
			}

			#openMenu = () => {
				this.#isOpen = true
				this.#menuAside?.classList.remove('-translate-x-full')
				this.#menuBackdrop?.classList.remove('hidden')
				this.#menuButton?.setAttribute('aria-expanded', 'true')
			}

			#closeMenu = () => {
				this.#isOpen = false
				this.#menuAside?.classList.add('-translate-x-full')
				this.#menuBackdrop?.classList.add('hidden')
				this.#menuButton?.setAttribute('aria-expanded', 'false')
			}

			#handleKeyDown = (event: KeyboardEvent) => {
				if (event.key === 'Escape' && this.#isOpen) {
					this.#closeMenu()
				}
			}

			#updateCurrentPage = () => {
				const currentSlug = this.getAttribute('data-slug')

				// Remove current page indicator from all links
				this.querySelectorAll(
					'#docs-summary-list a[aria-current=page]',
				).forEach((link) => {
					link.setAttribute('aria-current', 'false')
				})

				// Set current page indicator based on data-slug
				if (currentSlug) {
					const currentLink = this.querySelector(
						`#docs-summary-list a[data-slug="${currentSlug}"]`,
					)
					if (currentLink) {
						currentLink.setAttribute('aria-current', 'page')
						currentLink.scrollIntoView({ block: 'center' })
					}
				}
			}
		},
	)
</script>
