---
type Props = {
	className?: string
}

const { className } = Astro.props
---

<c-search>
	<button
		class:list={[
			'flex w-sm cursor-pointer items-center gap-2 rounded-lg border border-gray-200 px-3 py-2 hover:border-gray-300',
			className,
		]}
		data-searchbtn
	>
		<svg
			xmlns="http://www.w3.org/2000/svg"
			fill="none"
			viewBox="0 0 24 24"
			stroke-width="1.5"
			stroke="currentColor"
			class="size-5 text-gray-500"
		>
			<path
				stroke-linecap="round"
				stroke-linejoin="round"
				d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z"
			></path>
		</svg>
		<span class="text-gray-400">Search...</span><span
			class="ml-auto font-sans text-xs font-semibold text-gray-400">⌘K</span
		></button
	>
	<dialog
		data-searchdialog
		class="mx-auto mt-10 max-h-[80vh] w-full max-w-[min(90vw,45rem)] overflow-hidden bg-white p-0 shadow-sm backdrop:bg-black/30 backdrop:backdrop-blur-xs"
	>
		<div class="flex h-full flex-col">
			<div id="search" class="flex-1 overflow-auto p-4"></div>
		</div>
	</dialog>
</c-search>

<script>
	customElements.define(
		'c-search',
		class Search extends HTMLElement {
			#button: HTMLButtonElement | null = null
			#dialog: HTMLDialogElement | null = null
			#closeBtn: HTMLButtonElement | null = null

			constructor() {
				super()
			}

			connectedCallback() {
				this.#button = this.querySelector('[data-searchbtn]')
				this.#dialog = this.querySelector('[data-searchdialog]')
				this.#closeBtn = this.querySelector('[data-closebtn]')

				this.#button?.addEventListener('click', this.#openDialog)
				this.#closeBtn?.addEventListener('click', this.#closeDialog)
				this.#dialog?.addEventListener('click', this.#handleDialogClick)
				document.addEventListener('keydown', this.#handleKeydown)
				this.#initializePagefind()
			}

			disconnectedCallback() {
				this.#button?.removeEventListener('click', this.#openDialog)
				this.#closeBtn?.removeEventListener('click', this.#closeDialog)
				this.#dialog?.removeEventListener('click', this.#handleDialogClick)
				document.removeEventListener('keydown', this.#handleKeydown)
			}

			#initializePagefind() {
				//@ts-ignore
				new PagefindUI({
					element: '#search',
					showImages: false,
					showSubResults: true,
				})
			}
			#openDialog = () => {
				this.#dialog?.showModal()
			}

			#closeDialog = () => {
				this.#dialog?.close()
			}

			#handleDialogClick = (e: Event) => {
				if (e.target === this.#dialog) {
					this.#dialog?.close()
				}
			}

			#handleKeydown = (e: KeyboardEvent) => {
				if (e.key === 'k' && (e.metaKey || e.ctrlKey)) {
					e.preventDefault()
					this.#openDialog()
				}
			}
		},
	)
</script>
